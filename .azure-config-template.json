{
  "deployment": {
    "type": "App Service",
    "region": "eastasia",
    "resourceGroup": "your-resource-group",
    "appServiceName": "your-app-service-name",
    "appServicePlan": "your-app-service-plan"
  },
  "keyvault": {
    "name": "your-keyvault-name",
    "resourceGroup": "your-resource-group",
    "secrets": [
      {
        "name": "G-SYSTEM-API-URL",
        "value": "https://sungertain.deweichiu.com/api/articles/publish"
      },
      {
        "name": "G-SYSTEM-API-KEY",
        "value": "gsy_prod_1a2b3c4d5e6f7g8h9i0j_cowork_2026"
      }
    ]
  },
  "appInsights": {
    "enabled": true,
    "name": "your-app-insights-name",
    "resourceGroup": "your-resource-group"
  },
  "environmentVariables": {
    "AZURE_KEYVAULT_URL": "https://your-keyvault-name.vault.azure.net/",
